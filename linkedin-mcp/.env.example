# ── LinkedIn OAuth 2.0 ────────────────────────────────────────────────────────
# Required: Create a LinkedIn Developer App at https://developer.linkedin.com
# Required scopes: r_organization_social  w_organization_social
#                  r_organization_admin   rw_organization_admin
#                  r_organization_followers

# Long-lived access token (valid ~60 days; auto-refreshed if REFRESH_TOKEN set)
LINKEDIN_ACCESS_TOKEN=your_access_token_here

# Optional — enables automatic token refresh before expiry
LINKEDIN_REFRESH_TOKEN=your_refresh_token_here
LINKEDIN_CLIENT_ID=your_app_client_id
LINKEDIN_CLIENT_SECRET=your_app_client_secret

# ── Company page ──────────────────────────────────────────────────────────────
# Numeric ID from your company page URL or the /v2/organizationAcls API
# e.g. linkedin.com/company/12345678/ → 12345678
LINKEDIN_ORGANIZATION_ID=your_organization_id

# ── Scheduler ─────────────────────────────────────────────────────────────────
# Where to persist scheduled posts (default: ~/.linkedin-mcp/scheduled_posts.json)
# LINKEDIN_SCHEDULE_FILE=/path/to/scheduled_posts.json

# ── Claude Desktop config (add to ~/Library/Application Support/Claude/claude_desktop_config.json) ──
# {
#   "mcpServers": {
#     "linkedin": {
#       "command": "python",
#       "args": ["/absolute/path/to/linkedin-mcp/server.py"],
#       "env": {
#         "LINKEDIN_ACCESS_TOKEN": "...",
#         "LINKEDIN_ORGANIZATION_ID": "...",
#         "LINKEDIN_REFRESH_TOKEN": "...",
#         "LINKEDIN_CLIENT_ID": "...",
#         "LINKEDIN_CLIENT_SECRET": "..."
#       }
#     }
#   }
# }
#
# Daily posting via cron (runs publish_due_posts every 15 min):
# */15 * * * * python /path/to/linkedin-mcp/server.py --publish-due
